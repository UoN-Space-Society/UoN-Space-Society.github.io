{
  "name": "nottingham-space-society",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4173",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4173",
    "check": "astro check",
    "test": "npm run build && npm run test:analytics && npm run test:build && npm run test:browser",
    "test:build": "node --test tests/build.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:analytics": "node --test tests/analytics*.test.mjs",
    "analytics:report": "node tools/analytics-report.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "astro": "^7.4.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "cheerio": "^1.2.0",
    "google-auth-library": "^11.3.4",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  }
}
