{
  "name": "nottingham-space-society",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "analytics:report": "node tools/analytics-report.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "python3 -m http.server 4173 --bind 127.0.0.1",
    "build": "node build.mjs",
    "check": "node --check script.js && node --check analytics.js && node --check analytics-config.js && node --check tools/analytics-report.mjs && node --check tools/analytics-auth.mjs",
    "format": "prettier --write \"**/*.{html,css,js,mjs,json,yml,yaml,svg}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,mjs,json,yml,yaml,svg}\""
  },
  "devDependencies": {
    "google-auth-library": "^11.3.4",
    "prettier": "3.10.1"
  }
}
