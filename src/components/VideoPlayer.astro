<div
  class="video-frame"
  data-video-player
>
  <a
    class="video-play"
    href="https://www.youtube.com/watch?v=oqgHnKCRmLE"
    target="_blank"
    rel="noopener noreferrer"
  >
    Watch hybrid rocket engine video on YouTube ↗
  </a>
  <button
    class="video-play"
    type="button"
    hidden
  >
    <span aria-hidden="true">▶</span>
    Play hybrid rocket engine video
  </button>
</div>

<script>
  // Keep YouTube's scripts, fonts, and network requests out of the first render.
  const container = document.querySelector<HTMLElement>('[data-video-player]');
  const button = container?.querySelector<HTMLButtonElement>('button');
  const fallback = container?.querySelector<HTMLAnchorElement>('a');
  if (container && button && fallback) {
    button.hidden = false;
    fallback.hidden = true;
    button.addEventListener(
      'click',
      () => {
        const player = document.createElement('iframe');
        player.src =
          'https://www.youtube-nocookie.com/embed/oqgHnKCRmLE?autoplay=1';
        player.title =
          'Nottingham Space Society — hybrid rocket engine footage';
        player.allow =
          'autoplay; encrypted-media; picture-in-picture; fullscreen';
        player.allowFullscreen = true;
        player.referrerPolicy = 'strict-origin-when-cross-origin';
        container.replaceChildren(player);
        player.focus();
      },
      { once: true },
    );
  }
</script>

<style>
  .video-frame {
    display: grid;
    place-items: center;
  }
  .video-play:not([hidden]) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    max-width: 90%;
    padding: 20px;
    border: 1px solid var(--lime);
    background: transparent;
    color: var(--lime);
    font-size: 14px;
    text-align: center;
    cursor: pointer;
  }
</style>
