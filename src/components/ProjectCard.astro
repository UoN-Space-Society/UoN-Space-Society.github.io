---
import type { CollectionEntry } from "astro:content";
import "../styles/cards.css";
import OptimizedImage from "./OptimizedImage.astro";

interface Props {
  project: CollectionEntry<"projects">;
  featured?: boolean;
}
const { project, featured = false } = Astro.props;
const { data } = project;
const feature = featured ? data.featured : undefined;
---

<a
  class={featured ? "featured-project" : "project-photo-card"}
  href={`/projects/${project.id}.html`}
>
  <div
    class:list={[
      featured ? "project-image" : "project-photo",
      { "project-badge": !featured && data.badge },
    ]}
  >
    <OptimizedImage src={data.image} alt={data.imageAlt} />
  </div>
  <div class={featured ? "project-card-label" : "project-photo-caption"}>
    <div>
      {feature && <span class="mono">{feature.category}</span>}
      <h3>{feature?.title ?? data.title}</h3>
      {feature ? (
        <p>{feature.tagline}</p>
      ) : (
        <span class="mono">{data.category}</span>
      )}
    </div>
    <span class="project-card-arrow" aria-hidden="true">
      ↗
    </span>
  </div>
</a>
