---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import { projectDivisions } from '../data/project-divisions';
import '../styles/about.css';

const projects = await getCollection('projects');
---

<SiteLayout
  title="About — Nottingham Space Society"
  description="Meet Nottingham Space Society and our Rocketry, Spacecraft and Research teams."
>
  <main
    id="main"
    tabindex="-1"
    class="about-page"
  >
    <div class="about-introduction">
      <h1>About us</h1>
      <p>
        We’re Nottingham’s Space Society, a branch of UKSEDS. We bring students
        together to design, build and explore, with projects spanning rockets,
        spacecraft and scientific research.
      </p>
      <p>
        You don’t need a particular degree or a head start. Our three teams
        bring different interests and skills together around a shared curiosity
        about space.
      </p>
    </div>
    {projectDivisions.map((division) => {
      const project = projects.find(
        ({ id }) => id === division.featuredProject,
      )!;
      return (
        <section
          class="about-team"
          aria-labelledby={`about-${division.id}`}
        >
          <h2 id={`about-${division.id}`}>{division.title}</h2>
          <p>{division.description}</p>
          <figure>
            <OptimizedImage
              src={project.data.image}
              alt={project.data.imageAlt}
              widths={[320, 520, 1040]}
              sizes="(max-width: 600px) 90vw, 520px"
            />
            <figcaption>{project.data.title}</figcaption>
          </figure>
          <a
            class="text-link"
            href={`/projects.html#${division.id}`}
          >
            Explore {division.title.toLowerCase()} projects
          </a>
        </section>
      );
    })}
  </main>
</SiteLayout>
