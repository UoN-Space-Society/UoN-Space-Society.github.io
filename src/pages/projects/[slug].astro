---
import { getCollection, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import '../../styles/project.css';
import '../../styles/cards.css';

export async function getStaticPaths() {
  return (await getCollection('projects')).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { data } = project;
---

<SiteLayout
  title={`${data.title} — Nottingham Space Society`}
  description={data.description}
>
  <main
    id="main"
    tabindex="-1"
    class="project-page"
  >
    <a
      class="project-back mono"
      href="/projects.html"
    >
      ALL PROJECTS
    </a>
    <div class="project-page-heading">
      <p class="mono">{data.category}</p>
      <h1>{data.title}</h1>
    </div>
    <div class="project-page-layout">
      <figure class="project-page-figure">
        <div class:list={['project-photo', { 'project-badge': data.badge }]}>
          <OptimizedImage
            src={data.image}
            alt={data.imageAlt}
            sizes="(max-width: 650px) 90vw, 51vw"
            loading="eager"
          />
        </div>
        <figcaption class="mono">{data.category}</figcaption>
      </figure>
      <section
        class="project-page-copy"
        aria-labelledby="overview-title"
      >
        <h2 id="overview-title">The project</h2>
        <p>{data.description}</p>
        <a
          class="text-link"
          href={data.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {data.linkLabel}
        </a>
      </section>
    </div>
  </main>
</SiteLayout>
