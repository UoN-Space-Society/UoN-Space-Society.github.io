---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SponsorLogo from '../components/SponsorLogo.astro';
import sponsors from '../data/sponsors.json';
import VideoPlayer from '../components/VideoPlayer.astro';
import heroPhoto from '../assets/ssc-space-team.jpg';
import '../styles/home.css';
const homepageSponsors = sponsors.filter(
  (sponsor, index) =>
    sponsors.findIndex((entry) => entry.image === sponsor.image) === index,
);
const projects = await getCollection('projects');
const featuredProjects = ['helia', 'little-john'].map((id) =>
  projects.find((project) => project.id === id)!,
);
---

<SiteLayout
  title="SpaceSoc — University of Nottingham"
  description="Build rockets. Explore ideas. Find your people. The University of Nottingham Space Society brings space closer, whatever you study."
  home
>
  <main
    id="main"
    tabindex="-1"
  >
    <section
      class="landing-hero"
      aria-labelledby="landing-title"
    >
      <OptimizedImage
        class="landing-photo"
        src={heroPhoto}
        alt="Students gathered in the snow beside a rocket outside SSC Space"
        widths={[640, 960, 1440, 1920, 2583]}
        sizes="(max-width: 650px) max(100vw, 150svh, 810px), max(100vw, 150svh, 840px)"
        loading="eager"
        fetchpriority="high"
      />
      <div
        class="landing-shade"
        aria-hidden="true"
      ></div>
      <div class="landing-copy">
        <p class="mono">UNIVERSITY OF NOTTINGHAM / UKSEDS</p>
        <h1 id="landing-title">
          NOTTINGHAM
          <br />
          SPACE SOCIETY
        </h1>
        <p class="landing-tagline">
          A shared curiosity. An extraordinary universe.
        </p>
      </div>
      <a
        class="landing-down"
        href="#home-sponsors"
        aria-label="Discover our previous sponsors"
      >
        <span aria-hidden="true"></span>
      </a>
    </section>
    <section
      id="home-sponsors"
      class="home-sponsors section"
      aria-label="Previous sponsors"
    >
      <ul class="home-sponsor-logos">
        {homepageSponsors.map((sponsor) => (
          <li>
            <SponsorLogo
              image={sponsor.image}
              alt={sponsor.alt}
            />
          </li>
        ))}
      </ul>
    </section>
    <section
      id="projects"
      class="projects section"
      aria-labelledby="home-projects-title"
    >
      <div class="section-label mono">02 / BUILT BY THE CURIOUS</div>
      <div class="section-heading">
        <h2 id="home-projects-title">Ideas taking flight.</h2>
        <p>
          From living cells in the stratosphere
          <br />
          to rocket engines on the test stand.
        </p>
      </div>
      <div class="featured-projects">
        {featuredProjects.map((project) => (
          <ProjectCard
            project={project}
            featured
          />
        ))}
      </div>
      <a
        class="text-link"
        href="/projects.html"
      >
        Explore all our projects <span aria-hidden="true">↗</span>
      </a>
    </section>
    <section
      id="videos"
      class="videos section"
      aria-labelledby="videos-title"
    >
      <div class="section-label mono">03 / FROM THE TEST STAND</div>
      <div class="section-heading">
        <h2 id="videos-title">Videos</h2>
        <p>
          From an idea to ignition.
          <br />
          See our engineering in action.
        </p>
      </div>
      <figure class="video-feature">
        <VideoPlayer />
        <figcaption>
          <div>
            <span class="mono">01 / ENGINE TEST</span>
            <h3>Hybrid rocket engine</h3>
            <p>
              Footage from Nottingham Space Society’s hybrid rocket engine.
              Lower your volume before playing.
            </p>
          </div>
        </figcaption>
      </figure>
    </section>
    <section
      id="contact"
      class="home-contact section"
      aria-labelledby="home-contact-title"
    >
      <div>
        <h2 id="home-contact-title">Contact Us</h2>
        <p>Have a question about the society or our projects? Get in touch.</p>
      </div>
      <a
        class="button"
        href="/contact.html"
      >
        Contact Us <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>
</SiteLayout>

<script>
  import { initializeHero } from '../scripts/hero';
  initializeHero();
</script>
