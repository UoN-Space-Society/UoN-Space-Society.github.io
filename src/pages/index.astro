---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import SponsorLogo from '../components/SponsorLogo.astro';
import sponsors from '../data/sponsors.json';
import heroPhoto from '../assets/ssc-space-team.jpg';
import '../styles/home.css';
const homepageSponsors = sponsors.filter(
  (sponsor, index) =>
    sponsors.findIndex((entry) => entry.image === sponsor.image) === index,
);
const projects = await getCollection('projects');
const projectPictures = [
  'helia',
  'little-john',
  'preburner',
  'vector',
  'medlab',
  'rovin',
].map((id) => projects.find((project) => project.id === id)!);
---

<SiteLayout
  title="SpaceSoc — University of Nottingham"
  description="Build rockets. Explore ideas. Find your people. The University of Nottingham Space Society brings space closer, whatever you study."
  home
>
  <main
    id="main"
    tabindex="-1"
  >
    <section
      class="landing-hero"
      aria-labelledby="landing-title"
    >
      <OptimizedImage
        class="landing-photo"
        src={heroPhoto}
        alt="Students gathered in the snow beside a rocket outside SSC Space"
        widths={[640, 960, 1440, 1920, 2583]}
        sizes="(max-width: 650px) max(100vw, 150svh, 810px), max(100vw, 150svh, 840px)"
        loading="eager"
        fetchpriority="high"
      />
      <div
        class="landing-shade"
        aria-hidden="true"
      ></div>
      <div class="landing-copy">
        <p class="mono">UNIVERSITY OF NOTTINGHAM / UKSEDS</p>
        <h1 id="landing-title">
          NOTTINGHAM
          <br />
          SPACE SOCIETY
        </h1>
        <p class="landing-tagline">
          A shared curiosity. An extraordinary universe.
        </p>
      </div>
      <a
        class="landing-down"
        href="#home-sponsors"
        aria-label="Discover our previous sponsors"
      >
        <span aria-hidden="true"></span>
      </a>
    </section>
    <section
      id="home-sponsors"
      class="home-sponsors section"
      aria-label="Previous sponsors"
    >
      <ul class="home-sponsor-logos">
        {homepageSponsors.map((sponsor) => (
          <li>
            <SponsorLogo
              image={sponsor.image}
              alt={sponsor.alt}
            />
          </li>
        ))}
      </ul>
    </section>
    <section
      id="projects"
      class="projects section"
      aria-labelledby="home-projects-title"
    >
      <h2 id="home-projects-title">Project Pictures</h2>
      <ul class="project-collage">
        {projectPictures.map(({ id, data }) => (
          <li>
            <a
              href={`/projects/${id}.html`}
              aria-label={`Explore ${data.title}`}
            >
              <OptimizedImage
                src={data.image}
                alt={data.imageAlt}
                widths={[280, 560, 840]}
                sizes={
                  id === 'little-john'
                    ? '(max-width: 650px) 44vw, (max-width: 1200px) 46vw, 560px'
                    : '(max-width: 650px) 44vw, (max-width: 1200px) 25vw, 280px'
                }
              />
              <span>
                {id === 'medlab'
                  ? 'MEDLAB-1 concept'
                  : id === 'rovin'
                    ? 'Rover concept'
                    : data.title}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <section
      id="contact"
      class="home-contact section"
      aria-labelledby="home-contact-title"
    >
      <div>
        <h2 id="home-contact-title">Contact Us</h2>
        <p>Have a question about the society or our projects? Get in touch.</p>
      </div>
      <a
        class="button"
        href="/contact.html"
      >
        Contact Us <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>
</SiteLayout>

<script>
  import { initializeHero } from '../scripts/hero';
  initializeHero();
</script>
