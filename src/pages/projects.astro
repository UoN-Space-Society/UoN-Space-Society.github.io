---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projectDivisions } from '../data/project-divisions';
import '../styles/projects.css';

const projects = await getCollection('projects');
const currentProjects = projects.filter(({ data }) => data.group !== 'archive');
const archiveProjects = projects
  .filter(({ data }) => data.group === 'archive')
  .sort((a, b) => a.data.order - b.data.order);
if (currentProjects.some(({ data }) => !data.division)) {
  throw new Error('Every current project must belong to a division.');
}
---

<SiteLayout
  title="Our projects — Nottingham Space Society"
  description="Explore Nottingham Space Society’s rocket engines, stratospheric biology, rovers, satellites and earlier projects."
>
  <main
    id="main"
    tabindex="-1"
    class="projects-page"
  >
    <div class="projects-heading">
      <h1>Our projects</h1>
      <p>
        Rocket engines, living cells and machines built to explore. Discover the
        work of Nottingham Space Society.
      </p>
    </div>
    <nav
      class="division-navigation"
      aria-label="Project divisions"
    >
      {projectDivisions.map((division) => (
        <a href={`#${division.id}`}>{division.title}</a>
      ))}
    </nav>
    {projectDivisions.map((division) => (
      <section
        class="project-division"
        id={division.id}
        aria-labelledby={`${division.id}-title`}
      >
        <div class="division-heading">
          <h2 id={`${division.id}-title`}>{division.title}</h2>
          <p>{division.description}</p>
        </div>
        <ul class="division-gallery">
          {currentProjects
            .filter(({ data }) => data.division === division.id)
            .sort((a, b) => a.data.order - b.data.order)
            .map((project) => (
              <li>
                <ProjectCard project={project} />
              </li>
            ))}
        </ul>
      </section>
    ))}
    <section
      class="project-division"
      aria-labelledby="archive-title"
    >
      <div class="division-heading">
        <h2 id="archive-title">Earlier projects</h2>
        <p>Explore previous projects from across the society.</p>
      </div>
      <ul class="division-gallery">
        {archiveProjects.map((project) => (
          <li>
            <ProjectCard project={project} />
          </li>
        ))}
      </ul>
    </section>
  </main>
</SiteLayout>
